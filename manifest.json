{
  "manifest_version": 3,
  "name": "Wavez Toolkit",
  "version": "0.9.0",
  "description": "Auto-woot, auto-grab, queue tools, favorites, blocklist, notifications, AFK reply, DJ stats, room themes and mod assist for wavez.fm, built on the official WavezFM Extension API.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wavez-toolkit@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "96": "icon.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://wavez.fm/*",
    "https://www.wavez.fm/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wavez.fm/*",
        "https://www.wavez.fm/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wavez.fm/*",
        "https://www.wavez.fm/*"
      ],
      "js": [
        "shared.js",
        "bridge.js",
        "panel.js",
        "theme.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Wavez Toolkit",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
